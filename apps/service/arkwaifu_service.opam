opam-version: "2.0"
synopsis: "Read-only Arkwaifu Dream application"
maintainer: "Flandia"
authors: ["Flandia"]
homepage: "https://github.com/flandia/arkwaifu"
bug-reports: "https://github.com/flandia/arkwaifu/issues"
license: "MIT"
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
run-test: [["dune" "runtest" "-p" name "-j" jobs]]
depends: [
  "ocaml" {= "5.5.0"}
  "dune" {= "3.24.0"}
  "dream" {= "1.0.0~alpha8"}
  "caqti-lwt" {= "2.3.2"}
  "caqti-driver-sqlite3" {= "2.3.0"}
  "cohttp-lwt-unix" {= "6.2.1"}
  "yojson" {= "3.0.0"}
  "uri" {= "4.4.0"}
  "alcotest" {with-test & = "1.9.1"}
  "sqlite3" {with-test & = "5.4.1"}
]
